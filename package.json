{
  "name": "signscribe-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SignScribe web app, built from the Figma file 'SignScribe - Screens and Flow' (13 screens, 1440x900).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && vite build",
    "compare": "node tools/compare/screens.mjs",
    "models": "node tools/get-models.mjs",
    "e2e": "node tools/e2e/flow.mjs",
    "layout": "node tools/e2e/layout.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@mediapipe/tasks-vision": "0.10.21",
    "@xstate/react": "^4.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xstate": "^5.33.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "playwright": "1.49",
    "prettier": "^3.9.10",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
