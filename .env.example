# Sentence server (npm run server). Copy to .env. Nothing here is sent to the browser.
# Without a key the server answers with the offline rules only.
ANTHROPIC_API_KEY=
# SENTENCE_MODEL=claude-haiku-4-5-20251001
# HOST=127.0.0.1   # never 0.0.0.0 while ANTHROPIC_API_KEY is set (anyone on the network could spend your quota)
# WS_PORT=8787
# TCP_PORT=8788
# Origins allowed to open the WebSocket (comma separated; * = any, only for tests)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# LLM_TIMEOUT_MS=4000
# RATE_LIMIT=20             # messages per connection per 10 s
# GLOBAL_RATE_LIMIT=100     # messages from all connections together per 10 s
# MAX_CONNECTIONS=30        # WebSocket + TCP connections at the same time
# SENTENCE_PROVIDER=offline   # or fake (tests only)
