# Sentence server (npm run server). Copy to .env. Nothing here is sent to the browser.
# Without a key the server answers with the offline rules only.
ANTHROPIC_API_KEY=
# SENTENCE_MODEL=claude-haiku-4-5-20251001
# HOST=127.0.0.1
# WS_PORT=8787
# TCP_PORT=8788
# Origins allowed to open the WebSocket (comma separated; * = any, only for tests)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# LLM_TIMEOUT_MS=4000
# RATE_LIMIT=20
# SENTENCE_PROVIDER=offline   # or fake (tests only)
